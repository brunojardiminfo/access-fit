generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("customer")
  adminRole     String?
  phone         String?
  birthDate     DateTime?
  birthdayCouponYear Int?  // Ano em que recebeu cupom de aniversário
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses           Address[]
  orders              Order[]
  accounts            Account[]
  sessions            Session[]
  referralsGiven      Referral[] @relation("referrer")
  referralsReceived   Referral[] @relation("referred")
  sizePreference      UserSizePreference?
  notificationToken   NotificationToken?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String  @default("Casa")
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  zipCode    String

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  image    String?
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Float
  costPrice   Float?
  compareAt   Float?
  images      String   @default("[]")
  sizes       String   @default("[]")
  sizeRange   String?  // Para tamanho único: "PM" (P/M), "GGG" (G/GG), etc
  colors      String   @default("[]")
  sizeStock    String   @default("{}") // Estoque por tamanho: {"P/M": 2, "G/GG": 1}. "stock" abaixo é sempre a soma.
  stock        Int      @default(0)
  restockedAt  DateTime? // Última vez que o estoque subiu. Alimenta o selo "Novidade".
  sku          String?  @unique
  supplierCode String?
  featuredHero Boolean  @default(false)
  featured     Boolean  @default(false)
  saleDiscount           Float?
  onSale                 Boolean  @default(false)
  isConjunto             Boolean  @default(false)
  sellComponentsSeparately Boolean @default(false)
  active                 Boolean  @default(true)
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  conjuntoItems ConjuntoItem[]
  waitlist      Waitlist[]
  returnReplacements Return[]  @relation("ReturnReplacement")
}

model ConjuntoItem {
  id         String  @id @default(cuid())
  conjuntoId String
  name       String
  price      Float
  quantity   Int     @default(1)
  stock      Int     @default(0)

  conjunto Product @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
}

model CashInjection {
  id          String   @id @default(cuid())
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
}

model Campaign {
  id        String    @id @default(cuid())
  name      String
  channel   String    @default("instagram")
  startDate DateTime
  endDate   DateTime?
  budget    Float?
  result    String?
  notes     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  clientName String
  text      String
  rating    Int      @default(5)
  product   String?
  photo     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Goal {
  id        String   @id @default(cuid())
  month     Int
  year      Int
  target    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([month, year])
}

model Waitlist {
  id        String   @id @default(cuid())
  productId String
  name      String
  phone     String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referredId  String
  status      String   @default("pending")
  rewardGiven Boolean  @default(false)
  createdAt   DateTime @default(now())
  referrer    User     @relation("referrer", fields: [referrerId], references: [id])
  referred    User     @relation("referred", fields: [referredId], references: [id])
}

model InstagramMetric {
  id        String   @id @default(cuid())
  date      DateTime
  followers Int
  posts     Int      @default(0)
  reach     Int      @default(0)
  saves     Int      @default(0)
  likes     Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  discount    Float
  type        String    @default("percent")
  maxUses     Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Supplier {
  id        String    @id @default(cuid())
  name      String    @unique
  contact   String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expenses  Expense[]
}

model Expense {
  id                String    @id @default(cuid())
  date              DateTime
  description       String
  amount            Float
  category          String    @default("outros")
  paymentMethod     String    @default("pix")
  supplierId        String?
  notes             String?
  dueDate           DateTime?
  installments      Int       @default(1)
  installmentNumber Int       @default(1)
  groupId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  supplier  Supplier? @relation(fields: [supplierId], references: [id])
}

model Order {
  id         String   @id @default(cuid())
  userId     String
  addressId  String?
  status        String    @default("pending")
  paymentStatus String    @default("paid")
  paymentMethod String    @default("pix")
  amountPaid    Float     @default(0)
  dueDate          DateTime?
  installmentCount Int       @default(1)
  total         Float
  subtotal      Float
  shipping      Float    @default(0)
  discount      Float    @default(0)
  notes         String?
  couponCode    String?
  deliveredAt      DateTime?
  followUpSentAt   DateTime?
  thanks24hSentAt  DateTime?
  feedback7dSentAt DateTime?
  reengage30dSentAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  address       Address?             @relation(fields: [addressId], references: [id])
  items         OrderItem[]
  installments  Installment[]
  returns       Return[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  installmentId String?
  amount        Float
  receivedAt    DateTime @default(now())
  paymentMethod String
  notes         String?
  createdAt     DateTime @default(now())

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([receivedAt])
}

model Installment {
  id        String    @id @default(cuid())
  orderId   String
  number    Int
  amount    Float
  dueDate   DateTime
  paidAt    DateTime?
  status    String    @default("pending")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  size      String?
  color     String?
  componentName String? // Se é um componente do conjunto, salva o nome

  costPrice Float?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Return {
  id              String   @id @default(cuid())
  orderId         String
  status          String   @default("solicitado") // solicitado | aprovado | rejeitado | recebido | reembolsado
  reason          String?
  amount          Float
  requestedAt     DateTime @default(now())
  approvedAt      DateTime?
  returnedAt      DateTime?
  reimbursedAt    DateTime?
  notes           String?
  orderItemIds         String    @default("[]") // JSON com os IDs de OrderItem trocados/devolvidos
  returnedItemsSnapshot String   @default("[]") // JSON [{productId,size,quantity}] no momento da solicitação, usado para restaurar estoque mesmo se o OrderItem for trocado depois
  stockRestored        Boolean   @default(false) // Estoque dos itens devolvidos já foi restaurado?
  replacementProductId String?
  replacementSize      String?
  replacementSentAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  replacementProduct Product? @relation("ReturnReplacement", fields: [replacementProductId], references: [id])
}

model UserSizePreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  height        Int      // em cm
  weight        Int      // em kg
  bustSize      Int?     // em cm (opcional)
  waistSize     Int?     // em cm (opcional)
  preferredSize String?  // P, M, G (tamanho preferido recomendado)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
